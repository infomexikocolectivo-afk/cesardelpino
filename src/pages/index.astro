<!-- DIAGNÓSTICO SONORO -->
<section class="section section-diagnostico" id="diagnostico">
  <div class="section-inner">
    <div class="section-header reveal">
      <div class="section-number"><span class="num">02</span> &nbsp;&nbsp; Diagnóstico</div>
      <div class="section-title-wrap">
        <h2 class="section-title">¿Tu proyecto necesita sonido? <b>Te digo <em>qué</em> le hace falta.</b></h2>
        <p class="section-intro">
          Tres preguntas, treinta segundos. Sin registro, sin correo.
        </p>
      </div>
    </div>

    <div class="diag reveal" data-diag>
      <ol class="diag-log" data-diag-log aria-live="polite"></ol>

      <div class="diag-flow" data-diag-flow>
        <div class="diag-step is-active" data-step="1">
          <div class="diag-step-meta"><span class="diag-step-index">Paso 01 / 03</span></div>
          <h3 class="diag-question">¿Qué estás haciendo?</h3>
          <div class="diag-options">
            <button type="button" class="diag-option" data-value="cine" data-label="Una película o documental">
              <span class="diag-option-num">01</span>
              <span class="diag-option-text">Una película o documental</span>
            </button>
            <button type="button" class="diag-option" data-value="marca" data-label="Una marca o campaña">
              <span class="diag-option-num">02</span>
              <span class="diag-option-text">Una marca o campaña</span>
            </button>
            <button type="button" class="diag-option" data-value="espacio" data-label="Un espacio o instalación">
              <span class="diag-option-num">03</span>
              <span class="diag-option-text">Un espacio o instalación</span>
            </button>
            <button type="button" class="diag-option" data-value="evento" data-label="Un evento o experiencia">
              <span class="diag-option-num">04</span>
              <span class="diag-option-text">Un evento o experiencia</span>
            </button>
            <button type="button" class="diag-option" data-value="disco" data-label="Un disco o track">
              <span class="diag-option-num">05</span>
              <span class="diag-option-text">Un disco o track</span>
            </button>
          </div>
        </div>

        <div class="diag-step" data-step="2" hidden>
          <div class="diag-step-meta"><span class="diag-step-index">Paso 02 / 03</span></div>
          <h3 class="diag-question">¿En qué punto estás?</h3>
          <div class="diag-options">
            <button type="button" class="diag-option" data-value="idea" data-label="Todavía es una idea">
              <span class="diag-option-num">01</span>
              <span class="diag-option-text">Todavía es una idea</span>
            </button>
            <button type="button" class="diag-option" data-value="proceso" data-label="Está en proceso">
              <span class="diag-option-num">02</span>
              <span class="diag-option-text">Está en proceso</span>
            </button>
            <button type="button" class="diag-option" data-value="grabado" data-label="Ya está grabado, falta terminarlo">
              <span class="diag-option-num">03</span>
              <span class="diag-option-text">Ya está grabado, falta terminarlo</span>
            </button>
            <button type="button" class="diag-option" data-value="listo" data-label="Está terminado pero no suena bien">
              <span class="diag-option-num">04</span>
              <span class="diag-option-text">Está terminado pero no suena bien</span>
            </button>
          </div>
        </div>

        <div class="diag-step" data-step="3" hidden>
          <div class="diag-step-meta"><span class="diag-step-index">Paso 03 / 03</span></div>
          <h3 class="diag-question">¿Qué te preocupa más?</h3>
          <div class="diag-options">
            <button type="button" class="diag-option" data-value="transmitir" data-label="Que no transmita lo que quiero">
              <span class="diag-option-num">01</span>
              <span class="diag-option-text">Que no transmita lo que quiero</span>
            </button>
            <button type="button" class="diag-option" data-value="empezar" data-label="No sé por dónde empezar">
              <span class="diag-option-num">02</span>
              <span class="diag-option-text">No sé por dónde empezar</span>
            </button>
            <button type="button" class="diag-option" data-value="tiempo" data-label="Los tiempos de entrega">
              <span class="diag-option-num">03</span>
              <span class="diag-option-text">Los tiempos de entrega</span>
            </button>
            <button type="button" class="diag-option" data-value="nivel" data-label="Que no llegue a nivel profesional">
              <span class="diag-option-num">04</span>
              <span class="diag-option-text">Que no llegue a nivel profesional</span>
            </button>
          </div>
        </div>

        <div class="diag-result" data-diag-result hidden>
          <div class="diag-step-meta"><span class="diag-step-index">Diagnóstico</span></div>
          <h3 class="diag-result-title" data-diag-title></h3>
          <p class="diag-result-body" data-diag-body></p>
          <div class="diag-actions">
            <a href="#" class="diag-cta">Hablemos de tu proyecto <span aria-hidden="true">→</span></a>
            <button type="button" class="diag-reset" data-diag-reset>Empezar de nuevo</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- OME SECTION -->
<section class="section-ome" id="ome">
  <div class="ome-corner-top">
    <span class="dot"></span>
    <span class="label">El proyecto musical</span>
  </div>

  <div class="ome-inner reveal">
    <figure class="ome-header">
      <Image
        src={omeImage}
        alt="Sesión sonora inmersiva — proyecto musical Ome"
        width={2000}
        height={1333}
        quality={85}
        loading="lazy"
      />
    </figure>

    <div class="ome-text">
      <h2 class="ome-headline">
        Un universo sonoro donde lo <em>ritual</em> encuentra el dancefloor.
      </h2>
      <p class="ome-description">
        Es mi proyecto musical. Tracks, sets y experiencias en la frontera entre percusión tribal, house orgánico y melodías antropológicas de diversas culturas. Hago sonido para cuerpos en movimiento y espíritus en escucha.
      </p>

      <div class="ome-stats">
        <div>
          <div class="ome-stat-num">1M+</div>
          <div class="ome-stat-label">Plays<br />SoundCloud</div>
        </div>
        <div>
          <div class="ome-stat-num">7</div>
          <div class="ome-stat-label">Sellos<br />internacionales</div>
        </div>
        <div>
          <div class="ome-stat-num">10K</div>
          <div class="ome-stat-label">Oyentes mensuales<br />Spotify</div>
        </div>
      </div>

      <span class="ome-cta is-disabled" aria-disabled="true" role="link">
        Entrar al universo Ōme <span class="arrow">→</span>
      </span>
    </div>
  </div>
</section>

