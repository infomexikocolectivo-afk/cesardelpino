/* ACCORDION */
.service-accordion {
  border-top: 1px solid var(--border-line);
  padding: 0;
}

.service-accordion:last-of-type {
  border-bottom: 1px solid var(--border-line);
}

.service-accordion__title {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 0.75rem 0;
  cursor: pointer;
  list-style: none;
  user-select: none;
  transition: color 0.2s ease;
}

.service-accordion__header {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.service-accordion__title::-webkit-details-marker { display: none; }
.service-accordion__title::marker { display: none; }

.service-accordion__title:hover { color: var(--accent-blood); }
.service-accordion__title:hover .num { color: var(--accent-blood); }

.service-accordion__icon {
  font-family: var(--font-mono);
  font-size: 1.2rem;
  font-weight: 300;
  color: var(--accent-blood);
  transition: transform 0.2s ease;
  display: inline-block;
  flex-shrink: 0;
  transform-origin: center;
}

.service-accordion:not([open]) .service-accordion__title:hover .service-accordion__icon {
  transform: rotate(90deg);
}

.service-accordion[open] .service-accordion__icon {
  transform: rotate(45deg);
}

.service-accordion__content {
  padding: 0 0 2rem;
  animation: accordion-open 0.35s ease-out;
}

@keyframes accordion-open {
  from { opacity: 0; transform: translateY(-6px); }
  to   { opacity: 1; transform: translateY(0); }
}

/* Pulse loop: 700ms de pulso (0→1.35→1) + 2500ms de pausa = 3200ms total.
   700 / 3200 ≈ 21.9% de la timeline para el pulso, resto plano. */
@keyframes accordion-icon-pulse {
  0%     { transform: scale(1);    opacity: 1; }
  11%    { transform: scale(1.35); opacity: 1; }
  22%    { transform: scale(1);    opacity: 1; }
  100%   { transform: scale(1);    opacity: 1; }
}

/* El pulso vive en el span interno para no colisionar con el transform:rotate
   del outer (que maneja hover 90deg y open 45deg). */
.service-accordion__icon-inner {
  display: inline-block;
  transform-origin: center;
}

.works-grid .service-accordion .service-accordion__icon-inner {
  animation: accordion-icon-pulse 3200ms ease-out infinite;
}

.works-grid .service-accordion:nth-child(1) .service-accordion__icon-inner { animation-delay: 0ms; }
.works-grid .service-accordion:nth-child(2) .service-accordion__icon-inner { animation-delay: 150ms; }
.works-grid .service-accordion:nth-child(3) .service-accordion__icon-inner { animation-delay: 300ms; }
.works-grid .service-accordion:nth-child(4) .service-accordion__icon-inner { animation-delay: 450ms; }

/* Detener el pulso permanentemente cuando el usuario ya abrió el acordeón.
   .was-opened lo añade JS en el primer toggle; se mantiene aunque se cierre. */
.works-grid .service-accordion.was-opened .service-accordion__icon-inner,
.works-grid .service-accordion[open] .service-accordion__icon-inner {
  animation: none;
}

@media (prefers-reduced-motion: reduce) {
  .service-accordion__icon { transition: none; }
  .service-accordion__content { animation: none; }
  .works-grid .service-accordion .service-accordion__icon-inner { animation: none; }
}

