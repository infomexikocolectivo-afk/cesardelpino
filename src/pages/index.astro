    function showStep(n) {
      steps.forEach((s) => {
        const isCurrent = Number(s.dataset.step) === n;
        s.hidden = !isCurrent;
        s.classList.toggle('is-active', isCurrent);
      });
      if (resultBox) resultBox.hidden = true;
    }

    function appendLog(stepN, label) {
      if (!log) return;
      const li = document.createElement('li');
      li.className = 'diag-log-row';
      const q = document.createElement('span');
      q.className = 'diag-log-q';
      q.textContent = questions[stepN];
      const a = document.createElement('span');
      a.className = 'diag-log-a';
      a.textContent = label;
      li.appendChild(q);
      li.appendChild(a);
      log.appendChild(li);
    }

    function showResult(key) {
      const r = results[key];
      if (!r || !resultBox) return;
      if (resultTitle) resultTitle.textContent = r.title;
      if (resultBody) resultBody.textContent = r.body;
      steps.forEach((s) => {
        s.hidden = true;
        s.classList.remove('is-active');
      });
      resultBox.hidden = false;
    }

    function resetDiag() {
      answers[1] = null;
      answers[2] = null;
      answers[3] = null;
      if (log) log.innerHTML = '';
      showStep(1);
    }

    diag.addEventListener('click', (e) => {
      const target = e.target instanceof Element ? e.target : null;
      if (!target) return;

      const option = target.closest('.diag-option');
      if (option) {
        const stepEl = option.closest('.diag-step');
        if (!stepEl) return;
        const stepN = Number(stepEl.dataset.step);
        const value = option.dataset.value;
        const label = option.dataset.label || option.textContent?.trim() || '';
        if (!value) return;
        answers[stepN] = value;
        appendLog(stepN, label);
        if (stepN < 3) {
          showStep(stepN + 1);
        } else {
          showResult(answers[1] + '_' + answers[2]);
        }
        return;
      }

      if (target.closest('[data-diag-reset]')) {
        resetDiag();
      }
    });
  }
</script>
